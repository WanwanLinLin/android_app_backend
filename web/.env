# 后端 API 基础地址。开发态走 vite 代理时留空即可；独立部署 dist 时填后端完整地址，
# 例如 VITE_API_BASE=http://192.168.1.52:8852
VITE_API_BASE=

# 对称加密（accesskey）校验所用共享密钥，即后端 Redis db12 列表 hps_apikey 中的值。
# 需求 4：对受 validate_stream_accesskey 保护的接口，前端用该密钥自行计算
# token = SHA1(时间戳毫秒 + "\t" + APP_KEY)，不改动后端校验方式。
VITE_APP_KEY=hps_vgH7n7UCKjVr7k8kmdM
